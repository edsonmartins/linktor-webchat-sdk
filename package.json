{
  "name": "linktor-webchat-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Linktor WebChat widget SDK — core + plain-HTML loader + React/Vue/Angular wrappers",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/core build && pnpm -r --filter '!./packages/core' build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
