{
  "name": "@linktor/angular-webchat",
  "version": "0.1.0",
  "description": "Angular component/module for the Linktor WebChat widget",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/core": ">=15.0.0"
  },
  "dependencies": {
    "@linktor/webchat-core": "workspace:*"
  },
  "devDependencies": {
    "@angular/core": "^17.3.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
