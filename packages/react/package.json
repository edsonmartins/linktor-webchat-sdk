{
  "name": "@linktor/react-webchat",
  "version": "0.1.0",
  "description": "React component for the Linktor WebChat widget",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "dependencies": {
    "@linktor/webchat-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "author": "Edson Martins <edsonmartins2005@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:edsonmartins/linktor-webchat-sdk.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
