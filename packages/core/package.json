{
  "name": "@linktor/webchat-core",
  "version": "0.1.1",
  "description": "Framework-agnostic Linktor WebChat widget core",
  "keywords": ["linktor", "webchat", "chat", "widget", "livechat", "customer-support"],
  "homepage": "https://github.com/edsonmartins/linktor-webchat-sdk#readme",
  "bugs": "https://github.com/edsonmartins/linktor-webchat-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "author": "Edson Martins <edsonmartins2005@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:edsonmartins/linktor-webchat-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
